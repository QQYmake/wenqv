# Browser-local privacy mode: do not set server API keys, AGENT_SECRET_KEY,
# SQLite, Redis, or cookie identity variables. The application rejects them.

# Per-workspace file root (use an absolute path in production). This remains a
# separate server-side boundary for explicit file tools and exports.
AGENT_WORKSPACE_ROOT=

# Trusted packaged Skill catalogue. Keep it outside the writable workspace root.
AGENT_SKILLS_ROOT=

# Optional operational settings.
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_CORS_ORIGINS=
