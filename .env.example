# --- Per-user API configuration (change 2/3) ---
# Fernet key for encrypting user API keys at rest. NEVER commit this.
# Required when llm.require_user_config=true; the server fails fast without it.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_SECRET_KEY=

# When true, each visitor must configure their own API key in Settings;
# llm.main.* in config.yaml is only a fallback.
AGENT_REQUIRE_USER_CONFIG=

# --- Legacy / default LLM overrides (optional, only used as fallback) ---
AGENT_MAIN_API_KEY=
AGENT_MAIN_BASE_URL=https://api.openai.com/v1
AGENT_MAIN_MODEL=gpt-4.1-mini

# Per-workspace file root (use an absolute path in production).
AGENT_WORKSPACE_ROOT=

# Optional side cache; SQLite remains the source of truth.
REDIS_URL=