%%{init: {"theme": "base", "themeVariables": {"fontSize": "13px", "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif"}, "flowchart": {"nodeSpacing": 40, "rankSpacing": 55, "curve": "basis", "padding": 8}}}%%
flowchart TD
    %% ==================== 样式 ====================
    classDef client fill:#dbeafe,stroke:#2563eb,stroke-width:1.5px,color:#1e3a8a
    classDef api fill:#dcfce7,stroke:#16a34a,stroke-width:1.5px,color:#14532d
    classDef core fill:#fef9c3,stroke:#ca8a04,stroke-width:1.5px,color:#713f12
    classDef adapter fill:#f3e8ff,stroke:#9333ea,stroke-width:1.5px,color:#4c1d95
    classDef port fill:#ffedd5,stroke:#ea580c,stroke-width:1.5px,color:#7c2d12,stroke-dasharray:6 4
    classDef ext fill:#e5e7eb,stroke:#6b7280,stroke-width:1.5px,color:#111827

    %% ==================== ① 前端 ====================
    subgraph CLIENT["① React + Vite SPA — web/src"]
        direction TB
        App["App.tsx<br/>运行时状态枢纽"]
        UI["组件<br/>Composer（每轮 reasoning_effort）<br/>MessageList（折叠“思考中”）· ExecutionTrace"]
        APICLIENT["api/client.ts<br/>REST 请求 + fetch"]
        SSE["api/sse.ts<br/>parseSSEStream 增量解析"]
        LAKE["LakeBackground.tsx<br/>Three.js 湖面（懒加载）"]
    end

    %% ==================== ② FastAPI 传输层 ====================
    subgraph API["② FastAPI 传输层 — server/api + server/main"]
        direction TB
        MAIN["main.py<br/>懒加载组合根<br/>create_app / __getattr__"]
        AUTH["AuthMiddleware<br/>cookie → X-Workspace-ID · 401 守卫"]
        DEPS["dependencies.py<br/>get_workspace_id / get_services"]
        CHAT["chat.py<br/>reasoning_effort 校验 · SSE 编码<br/>404/412/409 · 取消协调"]
        SESSIONS["sessions.py<br/>workspace 作用域 CRUD"]
        META["meta.py<br/>/api/bootstrap · /api/skills · /api/config"]
        UCFG["user_config.py<br/>掩码读 · 加密写 · 连接探测"]
        SVC["services.py<br/>APIServices · AgentAdapter · RunCoordinator"]
    end

    %% ==================== ③ Agent Core ====================
    subgraph CORE["③ 与 HTTP 无关的 Agent Core — server/agent"]
        direction TB
        ACORE["AgentCore._stream<br/>可取消 ReAct 循环<br/>reasoning_delta 类型事件"]
        CTX["ContextManager.prepare<br/>token 预算 · summary 摘要 · 确定性截断"]
        SKILL["SkillManager<br/>scan · inject_selected · @mention"]
        REG["ToolRegistry + Tool<br/>校验 · 超时 · 结果截断"]
        TOOLS["内置工具<br/>calculator · read_file<br/>load_skill · remove_skill"]
        PORTS["端口 ports.py<br/>ClientResolver · ConversationStore<br/>WorkspaceResolver · LLMClient"]
    end

    %% ==================== ④ 出站适配器 ====================
    subgraph ADAPT["④ 出站适配器 — server/storage + llm_resolver + agent/llm.py"]
        direction TB
        SADAPTER["AgentStoreAdapter<br/>SQLite 记录 ↔ ChatMessage"]
        SQLITE["SQLiteStore<br/>WAL · asyncio.to_thread · BEGIN IMMEDIATE"]
        SCACHE["SideCache<br/>内存 TTL + 可选 Redis"]
        UREPO["UserConfigRepository<br/>Fernet 加解密 · 掩码 · 合并默认"]
        RESOLVER["LLMResolverAdapter<br/>每 workspace 解析 · LRU 客户端池"]
        OAI["OpenAICompatClient<br/>顶层 reasoning_effort<br/>兼容网关摘要尽力提取"]
        WRES["IsolatedWorkspaceResolver<br/>per-workspace 文件根"]
    end

    %% ==================== ⑤ 外部 ====================
    subgraph EXT["⑤ 外部 / 持久化"]
        direction TB
        DB[("SQLite 文件")]
        REDIS[("Redis（可选）")]
        REMOTE["OpenAI 兼容<br/>模型端点"]
        SKILLFILES["skills/*.md"]
        WFILES["workspace 文件"]
    end

    %% ==================== 前端内部 ====================
    App --> APICLIENT
    APICLIENT --> SSE
    App --> UI
    App -.-> LAKE

    %% ==================== 身份 / 配置链路 ====================
    APICLIENT -->|"GET /api/bootstrap"| META
    META -->|"Set-Cookie workspace_id"| APICLIENT
    APICLIENT -->|"所有 API 请求"| AUTH
    AUTH --> DEPS
    DEPS --> CHAT & SESSIONS & META & UCFG
    APICLIENT -->|"PUT /api/user/config"| UCFG
    UCFG -->|"掩码读 / 加密写"| UREPO
    UCFG -->|"warm() 失效缓存"| RESOLVER

    %% ==================== 聊天 / 取消链路 ====================
    UI -->|"选择 low / medium / high / max"| App
    APICLIENT -->|"POST /api/chat<br/>reasoning_effort + SSE"| CHAT
    CHAT --> SVC
    SVC -->|"AgentAdapter.stream"| ACORE
    CHAT -.->|"text / reasoning / tool 类型化 SSE"| APICLIENT
    APICLIENT -->|"POST /api/chat/abort"| CHAT
    SVC -->|"RunCoordinator.request_abort"| ACORE

    %% ==================== Agent Core 内部 ====================
    ACORE -->|"prepare_context 每轮"| CTX
    ACORE -->|"inject_selected"| SKILL
    ACORE -->|"tools.execute"| REG
    REG --> TOOLS
    ACORE --> PORTS
    CTX -->|"get_client('summary')"| PORTS
    ACORE -->|"get_client('main')<br/>同一运行继承所选强度"| PORTS
    TOOLS -->|"load_skill / remove_skill"| SKILL
    TOOLS -->|"read_file"| WFILES
    SKILLFILES -->|"scan"| SKILL

    %% ==================== 六边形边界：端口实现 ====================
    PORTS -.->|"实现 ClientResolver"| RESOLVER
    PORTS -.->|"实现 ConversationStore"| SADAPTER
    PORTS -.->|"实现 WorkspaceResolver"| WRES
    PORTS -.->|"实现 LLMClient"| OAI

    %% ==================== 持久化链路 ====================
    SADAPTER -->|"回答 + reasoning_summary/effort 元数据"| SQLITE
    SKILL -->|"inject_skill 去重持久化"| SADAPTER
    SQLITE --> DB
    SQLITE --> SCACHE
    SCACHE --> REDIS
    SESSIONS --> SQLITE
    CHAT --> SQLITE
    UREPO --> SQLITE

    %% ==================== 出站 ====================
    RESOLVER -->|"读取加密配置 + 合并默认"| UREPO
    RESOLVER -->|"构建 / 池化客户端"| OAI
    OAI -->|"Chat Completions stream / complete"| REMOTE
    WRES --> WFILES

    %% ==================== 组合根 ====================
    MAIN -.->|"装配 APIServices"| SVC
    MAIN -.->|"构建 store + SideCache"| SQLITE
    MAIN -.->|"构建 ClientResolver"| RESOLVER
    MAIN -.->|"懒加载组合 AgentCore"| ACORE

    %% ==================== 图例 ====================
    subgraph LEGEND["图例"]
        L1["前端"]:::client
        L2["FastAPI 传输层"]:::api
        L3["Agent Core"]:::core
        L4["出站适配器"]:::adapter
        L5["端口（抽象）"]:::port
        L6["外部 / 持久化"]:::ext
    end
