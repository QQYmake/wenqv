  classDef application fill:#ece7d9,stroke:#8c8063,color:#2e342f,stroke-width:1.4px;
  classDef core fill:#f0dfbd,stroke:#a57832,color:#3a2b18,stroke-width:1.5px;
  classDef infrastructure fill:#d8e6e1,stroke:#638c83,color:#173330,stroke-width:1.4px;

  class USER actor;
  class VIEW,APP,CLIENT,VISUAL browser;
  class ROOT,REST,CHAT,SERVICES application;
  class LOOP,POLICY,TOOLS,PORTS core;
  class AGENT_STORE,SQLITE_STORE,DB,CACHE,MEMORY,REDIS,LLM_CLIENT,REMOTE,SKILL_FILES,WORKSPACE infrastructure;
