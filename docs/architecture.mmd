%%{init: {"theme": "base", "themeVariables": {"fontFamily": "LXGW WenKai Lite, LXGW WenKai, serif", "background": "#f5f1e5", "primaryColor": "#e6eee8", "primaryTextColor": "#173330", "primaryBorderColor": "#648f85", "lineColor": "#47766f", "secondaryColor": "#f0dfbd", "tertiaryColor": "#d8e6e1", "clusterBkg": "#f8f5ea", "clusterBorder": "#8ca89f", "edgeLabelBackground": "#f8f5ea"}, "flowchart": {"curve": "basis", "nodeSpacing": 26, "rankSpacing": 42}}}%%
flowchart TB
  USER["User / Browser<br/>用户浏览器"]

  subgraph WEB["React + Vite SPA<br/>浏览器前端"]
    direction LR
    VIEW["Presentation<br/>Sidebar · Welcome · MessageList<br/>Markdown · ExecutionTrace · Composer"]
    APP["App.tsx state & orchestration<br/>sessions · messages · skills · draft · streaming<br/>event reduction · history hydration · local preferences"]
    CLIENT["api/client.ts + api/sse.ts<br/>REST · fetch stream · typed SSE parser · abort"]
    VISUAL["Presentation adapters<br/>LakeBackground · theme · responsive styles"]

    VISUAL -.- VIEW
    VIEW <--> APP
    APP --> CLIENT
  end

  subgraph API["FastAPI Transport & Application Services<br/>传输与应用协调层"]
    direction LR
    ROOT["server.main<br/>composition root · lifespan · CORS · SPA host"]
    REST["sessions.py + meta.py<br/>session CRUD · history · skills · config<br/>JSON REST"]
    CHAT["chat.py<br/>POST /api/chat · /api/chat/abort<br/>typed SSE encoding"]
    SERVICES["APIServices<br/>RunCoordinator · AgentAdapter · SkillCatalogAdapter"]

    ROOT -.->|"startup wiring<br/>启动装配"| REST
    ROOT -.-> CHAT
    ROOT -.-> SERVICES
    REST --> SERVICES
    CHAT --> SERVICES
  end

  subgraph CORE["HTTP-independent Agent Core<br/>核心执行层"]
    direction LR
    LOOP["AgentCore<br/>cancellable ReAct loop · bounded failures & turns"]
    POLICY["ContextManager + SkillManager<br/>budget · summary · truncation · scan · inject · deduplicate"]
    TOOLS["ToolRegistry + built-ins<br/>calculator · read_file · load_skill · remove_skill<br/>schema · timeout · result limit"]
    PORTS["Core ports<br/>ConversationStore · LLMClientProvider · WorkspaceResolver"]

    LOOP --> POLICY
    LOOP --> TOOLS
    LOOP --> PORTS
    POLICY --> PORTS
    TOOLS --> PORTS
  end

  subgraph INFRA["Outbound Adapters & Resources<br/>出站适配器与资源"]
    direction LR
    AGENT_STORE["AgentStoreAdapter<br/>ConversationStore implementation"]
    SQLITE_STORE["SQLiteStore<br/>repository + cache policy"]
    DB[("SQLite agent.db<br/>source of truth<br/>workspaces · sessions · messages · session_skills")]
    CACHE["SideCache<br/>best-effort cache policy<br/>default TTL 24h"]
    MEMORY[("MemoryTTLCache<br/>always available")]
    REDIS[("RedisJSONCache<br/>optional primary")]
    LLM_CLIENT["LLMClientFactory + OpenAICompatClient<br/>main / summary fallback"]
    REMOTE[["OpenAI-compatible API<br/>stream + complete"]]
    SKILL_FILES[("skills/*.md<br/>trusted model instructions")]
    WORKSPACE[("configured workspace files<br/>read_file safe root")]

    AGENT_STORE --> SQLITE_STORE
    SQLITE_STORE --> DB
    SQLITE_STORE -->|"cache reads + write invalidation<br/>读缓存 · 写失效"| CACHE
    CACHE --> MEMORY
    CACHE -.->|"optional<br/>可选"| REDIS
    LLM_CLIENT --> REMOTE
  end

  USER --> VIEW
  CLIENT -->|"JSON REST"| REST
  CLIENT ==>|"POST stream / abort<br/>typed SSE response · 类型化事件流"| CHAT
  SERVICES ==>|"AgentAdapter · stream / abort<br/>AgentEvent return"| LOOP
  SERVICES -->|"SkillCatalogAdapter"| POLICY

  SERVICES -->|"session · history · loaded-skill queries"| SQLITE_STORE
  PORTS --> AGENT_STORE
  PORTS --> LLM_CLIENT
  POLICY --> SKILL_FILES
  TOOLS -->|"read_file"| WORKSPACE
  PORTS --> WORKSPACE

  classDef actor fill:#173f3a,stroke:#173f3a,color:#ffffff,stroke-width:2px;
