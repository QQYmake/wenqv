    class UI,Client frontend;
    class App,Identity,Chat,Routes,Runs,Adapter api;
    class Core,Context,Registry,SkillMgr,StorePort agent;
    class Catalogue,Wenqu,Stages,Student skill;
    class Resolver,LLM,ConfigRepo,Exporter adapter;
    class Sqlite,Cache,Workspace,Files,Training,Exports state;
    class Provider,Tools external;
