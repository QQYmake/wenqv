# /etc/systemd/system/myapp.service
# Blue Lake Agent: one FastAPI/Uvicorn process behind nginx.
#
# The checked-in unit contains no secret. Put AGENT_SECRET_KEY and the
# deployment-specific paths in /etc/bluelake-agent.env instead.

[Unit]
Description=Blue Lake Agent (FastAPI/Uvicorn)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=bluelake-agent
Group=bluelake-agent
WorkingDirectory=/opt/bluelake-agent

EnvironmentFile=/etc/bluelake-agent.env
Environment=PATH=/opt/bluelake-agent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/bluelake-agent
Environment=XDG_CACHE_HOME=/var/cache/bluelake-agent

# Fail early when a build or the WeasyPrint/Pango runtime is missing.
ExecStartPre=/usr/bin/test -r /opt/bluelake-agent/web/dist/index.html
ExecStartPre=/opt/bluelake-agent/.venv/bin/python -c "import weasyprint; print(weasyprint.__version__)"
ExecStart=/opt/bluelake-agent/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# The application tree and the secret file are read-only to the service. Only
# SQLite, workspace files, exports, and the font/rendering cache are writable.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/bluelake-agent
ReadWritePaths=/var/lib/bluelake-agent /var/cache/bluelake-agent
StateDirectory=bluelake-agent
CacheDirectory=bluelake-agent

[Install]
WantedBy=multi-user.target
